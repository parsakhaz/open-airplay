+/* open-airplay: helpers for the now-playing lines the engine prints for a supervising process.
+ * Pure (no I/O, no globals) so they can be unit-tested; the printing lives in uxplay.cpp.
+ *   open-airplay: track <title>\t<artist>\t<album>
+ *   open-airplay: volume <0-100> */
+#ifndef OAP_AUDIO_H
+#define OAP_AUDIO_H
+
+#include <stddef.h>
+
+/* Copies len bytes of a metadata string into dst (cap bytes, always NUL-terminated). Tabs, CR and LF
+ * become spaces, so the field can't break the line; a field that doesn't fit is cut before the first
+ * UTF-8 character that doesn't fit whole. */
+static inline void oap_audio_field(char *dst, size_t cap, const char *src, size_t len) {
+    if (!dst || cap == 0) return;
+    size_t n = 0;
+    if (src) {
+        n = len < cap - 1 ? len : cap - 1;
+        if (n < len) {
+            /* back off to the start of the character that was cut */
+            while (n > 0 && ((unsigned char) src[n] & 0xC0) == 0x80) n--;
+        }
+    }
+    for (size_t i = 0; i < n; i++) {
+        char c = src[i];
+        dst[i] = (c == '\t' || c == '\r' || c == '\n') ? ' ' : c;
+    }
+    dst[n] = '\0';
+}
+
+/* The sender's volume slider as a percentage: AirPlay sends -30 dB (bottom) to 0 dB (top), -144 for mute. */
+static inline int oap_audio_volume_percent(float airplay_db) {
+    if (airplay_db <= -30.0f) return 0;
+    if (airplay_db >= 0.0f) return 100;
+    return (int) ((30.0f + airplay_db) / 30.0f * 100.0f + 0.5f);
+}
+
+#endif

+/* open-airplay: "disconnect" (a stdin control line, or the mirror window's close button) ends only the
+ * current client session: the same reset as conn_reset(), but the mirror window closes instead of
+ * freezing. The mDNS registration is kept, so the receiver stays in the sender's list.
+ * Always runs on the main loop thread (scheduled with g_idle_add). */
+static bool oap_disconnect_pending = false;
+
+static gboolean oap_disconnect_idle(gpointer data) {
+    oap_window_video_stopped();
+    close_window = true;
+    full_video_reset = true;
+    preserve_connections = false;   /* drop every connection of this client, HLS ones included */
+    reset_httpd = true;
+    relaunch_video = true;
+    oap_disconnect_pending = true;
+    reset_loop = true;   /* reset_callback quits the main loop; main() then resets the session */
+    return G_SOURCE_REMOVE;
+}
+
+static void oap_request_disconnect(void) {
+    g_idle_add(oap_disconnect_idle, NULL);   /* thread-safe: runs on the default main context */
+}
+
+static void oap_control_command(oap_control_cmd cmd, void *ctx) {
+    if (cmd == OAP_CONTROL_DISCONNECT) {
+        oap_request_disconnect();
+    }
+}
+
+/* Reads control lines from stdin. EOF or a read error (stdin closed, or NUL) just ends this thread. */
+static gpointer oap_control_thread(gpointer data) {
+    oap_control_reader reader = {};
+    char buf[256];
+    for (;;) {
+#ifdef _WIN32
+        /* raw ReadFile, not stdio: a thread blocked in fgets() holds the CRT stdin lock and can hang exit() */
+        DWORD n = 0;
+        if (!ReadFile(GetStdHandle(STD_INPUT_HANDLE), buf, sizeof(buf), &n, NULL) || n == 0) break;
+#else
+        ssize_t n = read(STDIN_FILENO, buf, sizeof(buf));
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+#endif
+        oap_control_feed(&reader, buf, (size_t) n, oap_control_command, NULL);
+    }
+    return NULL;
+}

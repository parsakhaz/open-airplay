+++ b/renderers/oap_control.h
@@ -0,0 +1,56 @@
+/* open-airplay: control lines a supervising process writes to the engine's stdin, one per line.
+ * Pure helpers (no I/O, no globals) so they can be unit-tested; the reader thread lives in uxplay.cpp.
+ *   disconnect   end the current client session; the receiver stays advertised and running */
+#ifndef OAP_CONTROL_H
+#define OAP_CONTROL_H
+
+#include <stddef.h>
+#include <string.h>
+
+typedef enum {
+    OAP_CONTROL_NONE = 0,     /* empty or unknown line: ignored */
+    OAP_CONTROL_DISCONNECT
+} oap_control_cmd;
+
+static inline int oap_control_is_space(char c) {
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f';
+}
+
+/* Parses one line (len bytes, no terminator needed); surrounding whitespace and CR are ignored. */
+static inline oap_control_cmd oap_control_parse(const char *line, size_t len) {
+    if (!line) return OAP_CONTROL_NONE;
+    while (len > 0 && oap_control_is_space(line[0])) { line++; len--; }
+    while (len > 0 && oap_control_is_space(line[len - 1])) len--;
+    if (len == strlen("disconnect") && memcmp(line, "disconnect", len) == 0) return OAP_CONTROL_DISCONNECT;
+    return OAP_CONTROL_NONE;
+}
+
+/* Splits a byte stream into lines. Lines longer than the buffer are dropped whole. */
+#define OAP_CONTROL_LINE_MAX 256
+typedef struct {
+    char buf[OAP_CONTROL_LINE_MAX];
+    size_t len;
+    int overflow;
+} oap_control_reader;
+
+/* Feeds n bytes; calls on_cmd(cmd, ctx) for every complete line that parses to a command. */
+static inline void oap_control_feed(oap_control_reader *r, const char *data, size_t n,
+                                    void (*on_cmd)(oap_control_cmd cmd, void *ctx), void *ctx) {
+    for (size_t i = 0; i < n; i++) {
+        char c = data[i];
+        if (c == '\n') {
+            if (!r->overflow) {
+                oap_control_cmd cmd = oap_control_parse(r->buf, r->len);
+                if (cmd != OAP_CONTROL_NONE && on_cmd) on_cmd(cmd, ctx);
+            }
+            r->len = 0;
+            r->overflow = 0;
+        } else if (r->len < sizeof(r->buf)) {
+            r->buf[r->len++] = c;
+        } else {
+            r->overflow = 1;
+        }
+    }
+}
+
+#endif

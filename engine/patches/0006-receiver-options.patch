     }
@@ -2476,6 +2477,11 @@ static int start_dnssd(std::vector<char> hw_addr, std::string name) {
     dnssd_set_airplay_features(dnssd, 61, 0); // Supports RFC2198 redundancy
     */
 
+    /* open-airplay: no photo (bit 1) or slideshow (bit 5) support: there is no /photo handler, so a
+     * phone that sends photos here would fail; with these off it offers mirroring instead */
+    dnssd_set_airplay_features(dnssd, 1, 0);
+    dnssd_set_airplay_features(dnssd, 5, 0);
+
     /* needed for HLS video support */
     dnssd_set_airplay_features(dnssd, 0, (int) hls_support);
     dnssd_set_airplay_features(dnssd, 4, (int) hls_support);
@@ -2557,6 +2563,7 @@ extern "C" void video_reset(void *cls, reset_type_t type) {
         break;
     case RESET_TYPE_HLS_SHUTDOWN:
         LOGD("video_reset: type = HLS_Shutdown");
+        printf("open-airplay: video link stopped\n");   /* machine-readable: the video link was torn down */
         if (use_video) {
             video_renderer_stop();
         }
@@ -3081,6 +3088,7 @@ extern "C" void on_video_play(void *cls, const char* location, const float start
     relaunch_video = true;
     preserve_connections = true;
     LOGI("********************on_video_play: location = %s*** start position %f ********************", url.c_str(), start_position);

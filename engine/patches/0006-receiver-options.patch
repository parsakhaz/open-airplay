--- a/uxplay.cpp
+++ b/uxplay.cpp
@@ -704,6 +704,7 @@ static gboolean video_eos_watch_callback (gpointer loop) {
     if (video_renderer_eos_watch()) {
         /* HLS video has sent EOS */
         LOGI("hls video has sent EOS");
+        printf("open-airplay: video link stopped\n");   /* machine-readable: the video link ended */
         video_renderer_hls_ready();

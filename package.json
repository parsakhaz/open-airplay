{
  "name": "open-airplay",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "sync-tokens": "node -e \"const fs=require('fs');for(const f of ['tokens.css','components.css'])fs.copyFileSync('design/'+f,'ui/'+f)\"",
    "build-sender": "node sender/python.js sender/freeze.py",
    "tauri": "tauri",
    "dev": "npm run sync-tokens && tauri dev",
    "build": "npm run sync-tokens && tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && npm run test:ui && npm run test:sender",
    "test:sender": "node sender/python.js -m unittest discover -s sender/tests",
    "test:ui": "node tests/ui/run.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}

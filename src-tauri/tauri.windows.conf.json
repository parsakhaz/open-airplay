{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../engine/runtime/": "engine/",
      "../sender/dist/oap-sender/": "sender/",
      "icons/icon.ico": "icons/icon.ico",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "windows/forget-credentials.ps1": "forget-credentials.ps1",
      "windows/uninstall-context.ps1": "uninstall-context.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        }
      }
    }
  }
}

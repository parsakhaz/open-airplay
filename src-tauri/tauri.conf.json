{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-airplay",
  "version": "0.1.0",
  "identifier": "org.openairplay.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run sync-tokens"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "open-airplay",
        "width": 340,
        "height": 540,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "license": "GPL-3.0-only",
    "resources": {
      "icons/icon.ico": "icons/icon.ico"
    }
  }
}
